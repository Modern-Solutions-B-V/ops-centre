# MS Ops Centre QR1 deployment profile.
# Copy to ods/.env on the deployment host and replace every GENERATE_ME value
# with a fresh value produced by the commands in docs/ms/deploy/QR1-DEPLOY-RUNBOOK.md.
# Never commit a filled copy.

ODS_VERSION=2.6.0
BIND_ADDRESS=127.0.0.1
ODS_MODE=local
ODS_MODEL_SWITCHBOARD=observe
LLM_BACKEND=external
LLM_API_BASE_PATH=/v1
LLM_API_URL=http://ms-qr1-host:11434
EXTERNAL_LLM_URL=http://127.0.0.1:11434
EXTERNAL_LLM_CONTAINER_URL=http://ms-qr1-host:11434
EXTERNAL_LLM_PROVIDER=ollama
EXTERNAL_LLM_MODEL=qwen3.8:27b
MS_QR1_HOST_GATEWAY=GENERATE_ME_DOCKER_GATEWAY
MS_QR1_TAILSCALE_HOSTNAME=
SKIP_MODEL_DOWNLOAD=true

GPU_BACKEND=amd
GPU_COUNT=1
MODEL_PROFILE=qwen
WEBUI_AUTH=true
WEBUI_ENABLE_SIGNUP=false
ENABLE_WEB_SEARCH=true
WEB_SEARCH_ENGINE=searxng
ENABLE_IMAGE_GENERATION=true
HERMES_DASHBOARD_TUI=0
LANGFUSE_ENABLED=true
REMOTE_LLM_ENABLED=false
LEMONADE_EXTERNAL=false
AMD_INFERENCE_RUNTIME=
AMD_INFERENCE_BACKEND=
AMD_INFERENCE_LOCATION=
AMD_INFERENCE_MANAGED=false

WEBUI_SECRET=GENERATE_ME_HEX_32
OPEN_WEBUI_ADMIN_EMAIL=
OPEN_WEBUI_ADMIN_PASSWORD=
OPEN_WEBUI_ADMIN_NAME=MS Ops Centre Admin
N8N_USER=admin@ods.local
N8N_PASS=GENERATE_ME_BASE64_24
LITELLM_KEY=GENERATE_ME_SK_ODS_HEX_32
ANTHROPIC_API_KEY=GENERATE_ME_FROM_BITWARDEN
LIVEKIT_API_KEY=GENERATE_ME_HEX_16
LIVEKIT_API_SECRET=GENERATE_ME_HEX_32
DIFY_SECRET_KEY=GENERATE_ME_HEX_32
SEARXNG_SECRET=GENERATE_ME_HEX_32
QDRANT_API_KEY=GENERATE_ME_HEX_32
DASHBOARD_API_KEY=GENERATE_ME_HEX_32
ODS_AGENT_KEY=GENERATE_ME_HEX_32_DISTINCT_FROM_DASHBOARD_API_KEY
ODS_SESSION_SECRET=GENERATE_ME_HEX_32
SHIELD_API_KEY=GENERATE_ME_HEX_32
TOKEN_SPY_API_KEY=GENERATE_ME_HEX_32
ODS_ROUTER_INTERNAL_KEY=GENERATE_ME_HEX_32

LANGFUSE_NEXTAUTH_SECRET=GENERATE_ME_HEX_32
LANGFUSE_SALT=GENERATE_ME_HEX_32
LANGFUSE_ENCRYPTION_KEY=GENERATE_ME_HEX_32
LANGFUSE_DB_PASSWORD=GENERATE_ME_HEX_32
LANGFUSE_CLICKHOUSE_PASSWORD=GENERATE_ME_BASE64_32
LANGFUSE_REDIS_PASSWORD=GENERATE_ME_BASE64_32
LANGFUSE_MINIO_ACCESS_KEY=GENERATE_ME_HEX_16
LANGFUSE_MINIO_SECRET_KEY=GENERATE_ME_BASE64_32
LANGFUSE_PROJECT_PUBLIC_KEY=pk-lf-GENERATE_ME_HEX_16
LANGFUSE_PROJECT_SECRET_KEY=sk-lf-GENERATE_ME_HEX_32
LANGFUSE_INIT_PROJECT_ID=GENERATE_ME_HEX_16
LANGFUSE_INIT_USER_EMAIL=admin@ods.local
LANGFUSE_INIT_USER_PASSWORD=GENERATE_ME_BASE64_24

OPENCODE_SERVER_PASSWORD=GENERATE_ME_UNUSED_QR1
OPENCLAW_TOKEN=GENERATE_ME_UNUSED_QR1
MINIMAX_API_KEY=
OPENAI_API_KEY=
TOGETHER_API_KEY=
BRAVE_SEARCH_API_KEY=
BRAVE_API_KEY=
HF_TOKEN=
TS_AUTHKEY=

ODS_AGENT_BIND=
ODS_AGENT_PORT=7710
ODS_AGENT_HOST=

TIMEZONE=Europe/Amsterdam
WEBUI_PORT=3000
DASHBOARD_PORT=3001
DASHBOARD_API_PORT=3002
LITELLM_PORT=4000
N8N_PORT=5678
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
SEARXNG_PORT=8888
WHISPER_PORT=9000
TTS_PORT=8880
